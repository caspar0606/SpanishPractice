# Copy to .env and fill in. .env is gitignored; this template is not.

# Required. OpenAI API access for exercise generation and marking.
OPENAI_API_KEY=

# Required. Shared secret users enter at login.
ACCESS_KEY=

# Optional. Comma-separated origins, needed when the UI is hosted separately
# from the API (for example a Vercel front end calling a Railway back end).
CORS_ORIGINS=

# Optional. Regex alternative to CORS_ORIGINS, useful for preview deployments.
# CORS_ORIGIN_REGEX=https://[a-zA-Z0-9-]+\.vercel\.app

# Optional. Where per-user JSON files are written. Defaults to ./userdata
# USERDATA_DIR=userdata
